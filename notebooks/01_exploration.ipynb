    "# Member 2 - Reactive A* Demonstration\n",
    "# Partial-observation navigation with obstacle discovery and replanning\n",
    "\n",
    "import heapq\n",
    "\n",
    "def manhattan(a, b):\n",
    "    return abs(a[0] - b[0]) + abs(a[1] - b[1])\n",
    "\n",
    "\n",
    "def astar(grid, start, goal):\n",
    "    rows = len(grid)\n",
    "    cols = len(grid[0])\n",
    "\n",
    "    open_list = []\n",
    "    heapq.heappush(open_list, (manhattan(start, goal), 0, start))\n",
    "\n",
    "    came_from = {}\n",
    "    g_score = {start: 0}\n",
    "\n",
    "    directions = [\n",
    "        (-1, 0), (1, 0),\n",
    "        (0, -1), (0, 1)\n",
    "    ]\n",
    "\n",
    "    while open_list:\n",
    "\n",
    "        _, current_g, current = heapq.heappop(open_list)\n",
    "\n",
    "        if current == goal:\n",
    "            path = [current]\n",
    "\n",
    "            while current in came_from:\n",
    "                current = came_from[current]\n",
    "                path.append(current)\n",
    "\n",
    "            path.reverse()\n",
    "            return path\n",
    "\n",
    "        for dr, dc in directions:\n",
    "\n",
    "            nr = current[0] + dr\n",
    "            nc = current[1] + dc\n",
    "\n",
    "            if not (0 <= nr < rows and 0 <= nc < cols):\n",
    "                continue\n",
    "\n",
    "            if grid[nr][nc] == 1:\n",
    "                continue\n",
    "\n",
    "            neighbour = (nr, nc)\n",
    "            new_g = current_g + 1\n",
    "\n",
    "            if new_g < g_score.get(neighbour, float(\"inf\")):\n",
    "\n",
    "                g_score[neighbour] = new_g\n",
    "                came_from[neighbour] = current\n",
    "\n",
    "                f = new_g + manhattan(neighbour, goal)\n",
    "\n",
    "                heapq.heappush(\n",
    "                    open_list,\n",
    "                    (f, new_g, neighbour)\n",
    "                )\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Ground-truth maze\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "rows = 10\n",
    "cols = 10\n",
    "\n",
    "ground_truth = [[0 for _ in range(cols)] for _ in range(rows)]\n",
    "\n",
    "# Hidden obstacle deliberately placed on the initial A* route\n",
    "true_obstacles = {\n",
    "    (0, 6),\n",
    "    (2, 4),\n",
    "    (3, 4),\n",
    "    (4, 4),\n",
    "    (5, 4),\n",
    "    (6, 4)\n",
    "}\n",
    "\n",
    "for r, c in true_obstacles:\n",
    "    ground_truth[r][c] = 1\n",
    "\n",
    "\n",
    "start = (0, 0)\n",
    "goal = (9, 9)\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Discovered map\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "discovered_map = [[0 for _ in range(cols)] for _ in range(rows)]\n",
    "\n",
    "robot_position = start\n",
    "\n",
    "replan_count = 0\n",
    "plan_count = 0\n",
    "actual_distance = 0\n",
    "discovered_obstacles = 0\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Observation model\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "def observe(position):\n",
    "\n",
    "    r, c = position\n",
    "\n",
    "    directions = [\n",
    "        (-1, 0), (1, 0),\n",
    "        (0, -1), (0, 1)\n",
    "    ]\n",
    "\n",
    "    observed = []\n",
    "\n",
    "    for dr, dc in directions:\n",
    "\n",
    "        nr = r + dr\n",
    "        nc = c + dc\n",
    "\n",
    "        if 0 <= nr < rows and 0 <= nc < cols:\n",
    "            observed.append((nr, nc))\n",
    "\n",
    "    return observed\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Reactive A* navigation\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "while robot_position != goal:\n",
    "\n",
    "    # Observe surroundings\n",
    "    observed_cells = observe(robot_position)\n",
    "\n",
    "    # Update discovered map\n",
    "    for r, c in observed_cells:\n",
    "\n",
    "        if ground_truth[r][c] == 1 and discovered_map[r][c] == 0:\n",
    "\n",
    "            discovered_map[r][c] = 1\n",
    "            discovered_obstacles += 1\n",
    "\n",
    "            print(\"Obstacle discovered at:\", (r, c))\n",
    "\n",
    "    # Plan using currently known map\n",
    "    path = astar(\n",
    "        discovered_map,\n",
    "        robot_position,\n",
    "        goal\n",
    "    )\n",
    "\n",
    "    if path is None:\n",
    "        print(\"No valid path available.\")\n",
    "        break\n",
    "\n",
    "    plan_count += 1\n",
    "\n",
    "    # Follow path one step at a time\n",
    "    path_blocked = False\n",
    "\n",
    "    for next_cell in path[1:]:\n",
    "\n",
    "        # Check whether the next cell is a newly discovered obstacle\n",
    "        r, c = next_cell\n",
    "\n",
    "        if ground_truth[r][c] == 1:\n",
    "\n",
    "            if discovered_map[r][c] == 0:\n",
    "\n",
    "                discovered_map[r][c] = 1\n",
    "                discovered_obstacles += 1\n",
    "\n",
    "                print(\"Obstacle discovered while moving:\", next_cell)\n",
    "\n",
    "            path_blocked = True\n",
    "            break\n",
    "\n",
    "        # Move robot\n",
    "        robot_position = next_cell\n",
    "        actual_distance += 1\n",
    "\n",
    "        # Observe after movement\n",
    "        observed_cells = observe(robot_position)\n",
    "\n",
    "        for r, c in observed_cells:\n",
    "\n",
    "            if ground_truth[r][c] == 1 and discovered_map[r][c] == 0:\n",
    "\n",
    "                discovered_map[r][c] = 1\n",
    "                discovered_obstacles += 1\n",
    "\n",
    "                print(\"Obstacle discovered at:\", (r, c))\n",
    "\n",
    "        # Check whether the remaining path is now blocked\n",
    "        remaining_path_blocked = False\n",
    "\n",
    "        for remaining_cell in path[path.index(next_cell) + 1:]:\n",
    "\n",
    "            if discovered_map[remaining_cell[0]][remaining_cell[1]] == 1:\n",
    "                remaining_path_blocked = True\n",
    "                break\n",
    "\n",
    "        if remaining_path_blocked:\n",
    "            path_blocked = True\n",
    "            break\n",
    "\n",
    "    # Replan only when current path is affected\n",
    "    if path_blocked and robot_position != goal:\n",
    "\n",
    "        replan_count += 1\n",
    "        print(\"Current path affected. Replanning with A*...\")\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# Results\n",
    "# ---------------------------------------------------------\n",
    "\n",
    "print(\"\\n========== Reactive A* Results ==========\")\n",
    "print(\"Start position:\", start)\n",
    "print(\"Goal position:\", goal)\n",
    "print(\"Final robot position:\", robot_position)\n",
    "print(\"Total A* plans:\", plan_count)\n",
    "print(\"Replan count:\", replan_count)\n",
    "print(\"Discovered obstacles:\", discovered_obstacles)\n",
    "print(\"Actual distance travelled:\", actual_distance)\n",
    "print(\"Navigation success:\", robot_position == goal)"
   ]
